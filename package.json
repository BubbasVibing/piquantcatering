{
  "name": "piquant",
  "version": "1.0.0",
  "description": "Luxury catering website",
  "scripts": {
    "dev": "cd client && npm run dev",
    "start": "cd client && npm run dev",
    "build": "cd client && npm install && npm run build",
    "preview": "cd client && npm run preview",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm install && npm run build",
    "prepare": "husky"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "web/**/*.{ts,tsx,js,jsx,css,json,md}": [
      "prettier --write"
    ]
  }
}
